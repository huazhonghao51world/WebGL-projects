# 新耀工厂数字孪生 · 本机配置（位于 local/xy.env，程序更新不会覆盖；修改后执行 bash xy.sh restart）

# 平台登录账号（TwinStudio 编辑器 / API 联调台）。不设置时默认 admin / admin123，交付客户前务必修改密码。
export TWIN_ADMIN_USER=admin
# export TWIN_ADMIN_PASSWORD='请改成强密码'

# AI小新大模型（可选；也可在编辑器「Agent 管理 → 模型配置」中填写，数据库中已保存的配置优先）
# export TWIN_AGENT_LLM_BASE_URL=https://api.example.com/v1
# export TWIN_AGENT_LLM_MODEL=model-name
# export TWIN_AGENT_LLM_API_KEY=sk-xxx

# 端口（一般不用改；改了要同步告知使用人员）
# PORT_DENGTA=3716     # 新耀工厂大屏
# PORT_EDITOR=5186     # TwinStudio 编辑器
# PORT_DEBUG=5188      # API 联调台
# PORT_DEMO=5185       # 平台演示站
# PORT_API=5184        # 平台 API
# PORT_PANEL=5099      # 服务控制面板
# PANEL_HOST=0.0.0.0   # 允许局域网其他电脑打开控制面板（默认仅本机）

# 数据目录（默认 ./data；数据盘空间不足时可改到其他磁盘，例如 /data/xy-twin）
# TWIN_DATA_DIR=/data/xy-twin

# 自动数据备份保留份数（每次更新前自动备份一次）
# BACKUP_KEEP=7

# 更新分支（一般不用改）
# XY_DEPLOY_BRANCH=deploy-kylin
